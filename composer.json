{
    "name": "kynx/mezzio-authentication-apikey",
    "description": "Authenticate users with an API key in Mezzio applications",
    "keywords": ["mezzio", "api", "authentication"],
    "type": "library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Matt Kynaston",
            "email": "matt@kynx.org"
        }
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "kynx/api-key-generator": "^2.3",
        "mezzio/mezzio-authentication": "^1.12",
        "psr/container": "^1.0 || ^2.0",
        "psr/http-factory": "^1.0"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3.1",
        "phpunit/phpunit": "^12.5.11",
        "psalm/plugin-phpunit": "0.19.5",
        "vimeo/psalm": "^6.15.1"
    },
    "autoload": {
        "psr-4": {
            "Kynx\\Mezzio\\Authentication\\ApiKey\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KynxTest\\Mezzio\\Authentication\\ApiKey\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "static-analysis": "psalm --shepherd --stats",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "laminas": {
            "config-provider": "Kynx\\Mezzio\\Authentication\\ApiKey\\ConfigProvider"
        }
    }
}
